#!/usr/bin/env bash
# Pull Google Calendar into calcurse (one-way).
#
# Deliberately one-way: Google serves recurring events whose RRULE calcurse
# cannot parse ("invalid until format"). Those never import, but calcurse-caldav
# still records them in sync.db — so a two-way run reads them as local deletions
# and removes them from the server. --init keep-remote never deletes remotely.
set -uo pipefail

lock="${XDG_DATA_HOME:-$HOME/.local/share}/calcurse/caldav/lock"
log="${XDG_CACHE_HOME:-$HOME/.cache}/calcurse-sync.log"
mkdir -p "$(dirname "$log")"

# A killed run leaves the lock behind and blocks every later sync.
rm -f "$lock"

if ! calcurse-caldav --init keep-remote >"$log" 2>&1; then
    if grep -qi "refresh token\|access token is missing" "$log"; then
        notify-send -u critical "calcurse sync" \
            "Google auth expired — run: calcurse-caldav --init keep-remote"
    else
        notify-send -u critical "calcurse sync failed" "See $log"
    fi
    exit 1
fi

tail -2 "$log"
