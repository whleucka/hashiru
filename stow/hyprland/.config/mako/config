anchor=top-right
font=CaskaydiaMono Nerd Font 10
background-color=#1A1B26FF
text-color=#C0CAF5FF
width=350
max-history=10
margin=20,20,20
padding=5
border-size=3
border-color=#7AA2FFFF
border-radius=4
default-timeout=3000
ignore-timeout=1
group-by=summary
icons=1

[urgency=critical]
default-timeout=10000
border-color=#F7768EFF

[grouped]
format=<b>%s</b>\n%b

# Do not disturb (SUPER+SHIFT+.): hide everything but critical ones, like a
# low battery. They're kept, and show again when it's turned off.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
