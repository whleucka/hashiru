{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": ["custom/hashiru", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"],
    "modules-center": ["clock"],
    "modules-right": ["group/tray-drawer", "custom/weather", "cpu", "memory", "pulseaudio", "custom/battery"],

    // Arch logo — nf-linux-archlinux (U+F303) from the font-logos range, which
    // CaskaydiaMono Nerd Font already carries, so it needs no fallback face.
    "custom/hashiru": {
        "format": "\uf303",
        "tooltip": false
    },

    "custom/ws1": {
        "exec": "~/.config/waybar/scripts/ws-button 1",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 1"
    },

    "custom/ws2": {
        "exec": "~/.config/waybar/scripts/ws-button 2",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 2"
    },

    "custom/ws3": {
        "exec": "~/.config/waybar/scripts/ws-button 3",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 3"
    },

    "custom/ws4": {
        "exec": "~/.config/waybar/scripts/ws-button 4",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 4"
    },

    "custom/ws5": {
        "exec": "~/.config/waybar/scripts/ws-button 5",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 5"
    },

    "custom/ws6": {
        "exec": "~/.config/waybar/scripts/ws-button 6 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 6"
    },

    "custom/ws7": {
        "exec": "~/.config/waybar/scripts/ws-button 7 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 7"
    },

    "custom/ws8": {
        "exec": "~/.config/waybar/scripts/ws-button 8 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 8"
    },

    "custom/ws9": {
        "exec": "~/.config/waybar/scripts/ws-button 9 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 9"
    },

    "custom/ws10": {
        "exec": "~/.config/waybar/scripts/ws-button 10 auto",
        "return-type": "json",
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/ws-click 10"
    },

    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        // Denver, not Edmonton: libstdc++'s std::chrono tzdb (which waybar uses)
        // mis-parses the America/Edmonton zone and drops its DST rule, losing an
        // hour. Denver has identical Mountain-time rules and parses correctly.
        "timezone": "America/Denver",
        "on-click": "kitty --class calcurse calcurse",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "tooltip-format": "Load avg: {loadavg}",
        "interval": 2,
        "on-click": "kitty --class btop btop"
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "interval": 10,
        "on-click": "kitty --class btop btop"
    },

    "custom/weather": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/weather",
        "interval": 600,
        "tooltip": true,
        "on-click": "xdg-open 'https://weather.gc.ca/en/location/index.html?coords=49.693,-112.835'",
        "return-type": "json"
    },

    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery",
        "interval": 5,
        "return-type": "json",
        "tooltip": true,
        "on-click-right": "~/.config/waybar/scripts/cycle-power-profile",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰖁 muted",
      "on-click": "pavucontrol",
      "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +1%",
      "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -1%",
      "scroll-step": 1,
      "format-icons": {
        "muted": "󰖁",
        "default": ["󰕿", "󰖀", "󰕾"]
      }
    },

    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/tray-tag",
            "tray"
        ]
    },

    "custom/tray-tag": {
        "format": "❮",
        "tooltip": false
    },

    "tray": {
        "spacing": 14,
        "icon-size": 16,
        "show-passive-items": true
    }
}
