#!/usr/bin/env bash
# Unified directional navigation: one keychain across Hyprland / tmux / neovim.
#
# Bound to super+hjkl in Hyprland. Args:
#   $1 = Hyprland focus direction (l|r|u|d)
#   $2 = nav key to inject into a terminal (h|j|k|l)
#
# If the focused window is a terminal (kitty), inject ctrl+alt+<key> into it via
# kitty remote control. That drives the nav chain — tmux (bind -n C-M-hjkl) ->
# neovim smart-splits -> and, at the outermost edge, back out to the Hyprland
# window (via scripts/focus). For any other window, just move Hyprland focus
# directly.
#
# ctrl+alt+hjkl (not plain ctrl+hjkl) is the plumbing key so that bare ctrl+hjkl
# stays free for the shell/readline (backspace, kill-line, clear, newline). The
# user never presses ctrl+alt+hjkl directly — it's injection-only, and kitty
# remote control writes it straight to the pty, bypassing Hyprland (so it never
# collides with the ctrl+alt+l lock keybind).
#
# Hyprland 0.55+ Lua config: hyprctl dispatch evaluates its arg as Lua, so we
# pass an hl.dsp.* expression rather than a raw dispatcher name.

dir="$1"
key="$2"

# Injecting only helps if something inside the terminal actually binds
# ctrl+alt+hjkl. A bare kitty running a shell (or claude, or any other plain
# program) swallows the key and focus never moves — so ask kitty what is running
# in the focused window first, and only inject for the programs in the nav chain.
# Anything else falls through to a normal Hyprland focus move.
#
# ssh is in the list because remote herdr on elitedesk is a common case. It has
# to be, and it is a blunt instrument: an ssh session is judged by the LOCAL
# `ssh` process, so there is no way to tell `ssh elitedesk` running herdr from
# `ssh elitedesk` running a plain shell. Both get the injection.
#
# The trade that buys: super+hjkl now drives panes inside a remote herdr, but in
# a plain remote shell the chord is swallowed by the far end and focus does not
# move at all (no fall-through to a Hyprland focus move — that decision is made
# here, before the key is sent). Drop ssh from NAV_APPS to get the old behaviour
# back.
#
# Note that with `herdr --remote <host>` the local process is `herdr`, which
# already matched before ssh was added — but keybindings then default to
# `local`, so the chord runs herdr-route against the LOCAL socket. Use
# `--remote-keybindings server` for that path so the remote herdr interprets it.
NAV_APPS='(^|/)(herdr|nvim|vim|ssh)( |$)'

info=$(hyprctl activewindow)
class=$(awk '/^[[:space:]]*class:/{print $2; exit}' <<<"$info")
pid=$(awk '/^[[:space:]]*pid:/{print $2; exit}'   <<<"$info")

inject=0
if [ "$class" = "kitty" ] && [ -S "/tmp/mykitty-$pid" ]; then
  # Prefer the focused kitty window; fall back to any window of this instance.
  # (is_focused goes false everywhere the moment kitty is not the active OS
  # window, so the fallback keeps a focus race from breaking the herdr case.)
  fg=$(timeout 1 kitty @ --to "unix:/tmp/mykitty-$pid" ls 2>/dev/null |
       jq -r '[..|objects|select(has("foreground_processes"))] as $w
              | (first($w[]|select(.is_focused == true)) // $w[0])
              | [.foreground_processes[]?.cmdline|join(" ")]|join(" ")' 2>/dev/null)
  # No answer from kitty (socket busy, jq missing) -> fall through to focus move,
  # so the keypress always does something.
  [[ "$fg" =~ $NAV_APPS ]] && inject=1
fi

if [ "$inject" = 1 ]; then
  kitty @ --to "unix:/tmp/mykitty-$pid" send-key "ctrl+alt+$key"
else
  hyprctl dispatch "hl.dsp.focus({ direction = \"$dir\" })"
fi
