#!/usr/bin/env bash
# Unified directional navigation: one keychain across neovim / kitty / Hyprland.
#
#   nav <h|j|k|l>          bound to super+hjkl in Hyprland
#   nav --edge <h|j|k|l>   called by (n)vim when it is already at its own edge
#
# The chain, innermost first:
#   (n)vim split -> kitty window (split) -> Hyprland window
#
# If the focused window is kitty and the kitty window in focus is running
# (n)vim, inject ctrl+alt+<key> into it via kitty remote control and let the
# editor decide: it moves between its own splits, and at its edge calls back
# here with --edge. Otherwise — a shell, or --edge — try the kitty window that
# way, and if kitty has none (or isn't the focused window) move Hyprland focus.
#
# ctrl+alt+hjkl (not plain ctrl+hjkl) is the plumbing key so that bare ctrl+hjkl
# stays free for the shell/readline (backspace, kill-line, clear, newline). The
# user never presses ctrl+alt+hjkl directly — it's injection-only, and kitty
# remote control writes it straight to the pty, bypassing Hyprland (so it never
# collides with the ctrl+alt+l lock keybind).
#
# The editor side lives in the personal dotfiles (nvim/vim config), not here.
# Without it, injecting would be swallowed, so only programs known to bind the
# chord get it — anything else is handled here directly.
NAV_APPS='(^|/)(nvim|vim)( |$)'

edge=0
if [ "$1" = --edge ]; then edge=1; shift; fi
key="$1"

case "$key" in
  h) dir=l; side=left   ;;
  j) dir=d; side=bottom ;;
  k) dir=u; side=top    ;;
  l) dir=r; side=right  ;;
  *) echo "usage: nav [--edge] <h|j|k|l>" >&2; exit 2 ;;
esac

info=$(hyprctl activewindow)
class=$(awk '/^[[:space:]]*class:/{print $2; exit}' <<<"$info")
pid=$(awk '/^[[:space:]]*pid:/{print $2; exit}'   <<<"$info")

sock="${XDG_RUNTIME_DIR}/mykitty-$pid"   # kitty.conf listen_on, plus the pid kitty appends
if [ "$class" = "kitty" ] && [ -S "$sock" ]; then
  k() { timeout 1 kitty @ --to "unix:$sock" "$@" 2>/dev/null; }

  if [ "$edge" = 0 ]; then
    # What is running in the focused kitty window of the focused tab.
    fg=$(k ls --match state:focused |
         jq -r '[..|objects|select(has("foreground_processes"))][0]
                | [.foreground_processes[]?.cmdline|join(" ")]|join(" ")' 2>/dev/null)
    if [[ "$fg" =~ $NAV_APPS ]]; then
      k send-key "ctrl+alt+$key"
      exit 0
    fi
  fi

  # Neighbouring kitty window that way? Fails (no match) at kitty's own edge,
  # and always in the stack layout, where only one window is visible.
  k focus-window --match "neighbor:$side" && exit 0
fi

# scripts/focus also handles monocle, where j/k cycle the stack.
exec "$(dirname "$0")/focus" "$dir"
