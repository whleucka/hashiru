#!/usr/bin/env bash
# Time-of-day wallpaper cycler for the Tahoe Beach set.
#
# Usage:
#   tahoe-wallpaper          set wallpaper for the current time and exit
#   tahoe-wallpaper daemon   loop forever, switching on period change
#
# A wallpaper picked by hand wins: when ~/.config/hashiru/wallpaper names a
# readable image (hashiru-tui writes it), that is shown instead of the cycle,
# until the file is removed. The cycle then resumes within CHECK_INTERVAL.

WALLPAPER_DIR="$HOME/.config/hypr/wallpapers"
STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/tahoe-wallpaper-period"
CHECK_INTERVAL=300 # seconds; short so suspend/resume catches up quickly
CHOICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hashiru/wallpaper"

# The fixed wallpaper, if one is set and still exists. A choice whose image
# has gone is ignored rather than leaving the desktop blank.
fixed_choice() {
    local f
    [[ -r $CHOICE_FILE ]] || return 1
    read -r f <"$CHOICE_FILE" || [[ -n $f ]] || return 1
    [[ -n $f && -r $f ]] || return 1
    printf '%s\n' "$f"
}

period_for_hour() {
    local hour=$1
    if ((hour >= 5 && hour < 8)); then
        echo Dawn
    elif ((hour >= 8 && hour < 17)); then
        echo Day
    elif ((hour >= 17 && hour < 20)); then
        echo Dusk
    else
        echo Night
    fi
}

apply() {
    local period force=$2 fixed
    if fixed=$(fixed_choice); then
        # The state file records what is showing, so the daemon applies a
        # choice once rather than every tick, and notices when it's cleared.
        if [[ $force != force && -f $STATE_FILE && $(<"$STATE_FILE") == "fixed:$fixed" ]]; then
            return
        fi
        awww img "$fixed" --transition-type fade --transition-duration 2 &&
            echo "fixed:$fixed" >"$STATE_FILE"
        return
    fi
    period=$(period_for_hour "$((10#$(date +%H)))")
    if [[ $force != force && -f $STATE_FILE && $(<"$STATE_FILE") == "$period" ]]; then
        return
    fi
    awww img "$WALLPAPER_DIR/26-Tahoe-Beach-$period.jpg" \
        --transition-type fade --transition-duration 2 &&
        echo "$period" >"$STATE_FILE"
}

if [[ $1 == daemon ]]; then
    apply "" force
    while sleep "$CHECK_INTERVAL"; do
        apply
    done
else
    apply "" force
fi
