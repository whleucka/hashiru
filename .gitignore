# Hashiru live-ISO build artifacts
/iso/out/
/iso/work/

# Per-machine overrides (see hashiru.conf.example). Untracked on purpose:
# `hashiru update` refuses to run on a dirty checkout.
/hashiru.conf

# Python bytecode. kitty compiles its kittens (kitty/new_session.py) into a
# __pycache__ beside them, and ~/.config/kitty is a stow fold, so that lands
# in the checkout.
__pycache__/

# Thunar rewrites this on every run (bookmark hashes, line reordering).
# All entries are commented defaults, so there is nothing worth tracking.
/stow/thunar/.config/Thunar/accels.scm

# Prevent gtk-3 bookmarks
/stow/hyprland/.config/gtk-3.0/bookmarks

