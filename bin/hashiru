#!/usr/bin/env bash
# hashiru — manage an installed Hashiru system.
#
#   hashiru update [stage ...]   pull latest, then replay the install stages
#   hashiru update --no-confirm  ... without stopping to ask anything
#   hashiru doctor               read-only health check
#   hashiru status               where this install came from, and how stale
#   hashiru log                  the install log
#   hashiru report               warnings from the last install
#   hashiru changelog            release notes, newest first
#
# `update` works by replaying install.sh, not by computing a diff: every stage
# is idempotent, and `stow --restow` in 45-config.sh reconciles added, removed
# and renamed config files on its own. Replay is the update mechanism.

set -euo pipefail

# Resolve the symlink first: this is normally invoked as /usr/local/bin/hashiru,
# where a plain dirname would put the repo at /usr/local and fail to find lib/.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SELF}")/.." && pwd)"

# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

usage() {
    cat << EOF
Usage: hashiru <command> [args]

Commands:
  update [stage ...]   Pull the latest Hashiru, then run install.sh.
                       Stage selectors are passed straight through, so
                       'hashiru update 45' re-applies only config and
                       'hashiru update 45+' runs stage 45 onward.
  install [stage ...]  Run install.sh WITHOUT pulling. For iterating on local
                       changes — 'update' refuses on a dirty checkout.
  doctor               Read-only health check (never modifies the system).
  status               Show install provenance and whether a pull is available.
  log [-f]             Page the install log; -f follows it live.
  report               Warnings from the last install, if there were any.
  changelog [tag]      Release notes, newest first, or just one tag's.
  help                 This message.

Stage selectors match install.sh: N, N+, --from N, or several at once.
See 'install.sh --list'.

Flags (accepted by both 'update' and 'install', passed to install.sh):
  --no-confirm         Answer every prompt with yes. The only prompt a run has
                       left is the reboot at the end, so on a full run this
                       does reboot — pair it with --no-reboot if you'd rather
                       it didn't. Package transactions were already
                       non-interactive (pacman and yay run --noconfirm).
  --no-reboot          Never reboot and never ask. Wins over --no-confirm.
  --no-reflector       Skip stage 10's mirror ranking, worth about a minute.
                       reflector.timer has been re-ranking weekly since this
                       machine was built, so on an update the ranking buys
                       nothing; the timer stays enabled either way. Settable
                       for good via HASHIRU_NO_REFLECTOR=1 in hashiru.conf.

Neither flag touches the dirty-checkout refusal or the sudo password prompt:
the first is a hard error rather than a question, and the second can't be
answered with a "y". For a genuinely unattended update, warm the sudo
timestamp first ('sudo -v') or give the user NOPASSWD.

Repo: ${HASHIRU_ROOT}
EOF
}

# Fetch and report how far behind origin this checkout is. Echoes the number of
# commits behind; empty if that can't be determined (no remote, no network).
_behind_count() {
    local branch upstream
    branch="$(git -C "${HASHIRU_ROOT}" rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 0
    upstream="$(git -C "${HASHIRU_ROOT}" rev-parse --abbrev-ref "${branch}@{upstream}" 2>/dev/null)" || return 0
    git -C "${HASHIRU_ROOT}" fetch --quiet 2>/dev/null || return 0
    git -C "${HASHIRU_ROOT}" rev-list --count "HEAD..${upstream}" 2>/dev/null || return 0
}

cmd_update() {
    if [[ ! -d "${HASHIRU_ROOT}/.git" ]]; then
        log_error "${HASHIRU_ROOT} is not a git checkout — cannot update."
        log_error "Re-clone it: git clone https://github.com/whleucka/hashiru.git"
        exit 1
    fi

    # A dirty tree means local edits that a pull would either clobber or
    # conflict with. Local changes to a system's own config are legitimate —
    # they just need to be committed or stashed deliberately, not by this tool.
    if [[ -n "$(git -C "${HASHIRU_ROOT}" status --porcelain)" ]]; then
        log_error "${HASHIRU_ROOT} has uncommitted changes — commit or stash them first."
        git -C "${HASHIRU_ROOT}" status --short
        exit 1
    fi

    local before after
    before="$(git -C "${HASHIRU_ROOT}" rev-parse HEAD)"

    log_info "Pulling latest Hashiru into ${HASHIRU_ROOT}"
    if ! git -C "${HASHIRU_ROOT}" pull --ff-only; then
        log_error "Pull failed — resolve it manually, then re-run 'hashiru update'."
        exit 1
    fi

    after="$(git -C "${HASHIRU_ROOT}" rev-parse HEAD)"
    if [[ "${before}" == "${after}" ]]; then
        log_info "Already up to date (${after:0:12}) — replaying stages anyway to repair any drift"
    else
        log_info "Updated ${before:0:12} -> ${after:0:12}"
        git -C "${HASHIRU_ROOT}" --no-pager log --oneline "${before}..${after}" | head -20
    fi

    "${HASHIRU_ROOT}/install.sh" "$@"

    # install.sh only stamps on a full run, and an update with stage selectors
    # is not one — but the machine is still now running this commit, which is
    # exactly what the stamp is supposed to answer. Record it either way.
    local version
    version="$(git -C "${HASHIRU_ROOT}" describe --tags 2>/dev/null || echo unknown)"
    printf 'HASHIRU_VERSION=%s\nHASHIRU_COMMIT=%s\nHASHIRU_INSTALL_DATE=%s\nHASHIRU_UPDATED=%s\n' \
        "${version}" "${after}" "$(_install_date)" "$(date -Is)" | sudo tee /etc/hashiru-release > /dev/null
    log_success "Update complete (${version})"
}

# Preserve the original install date across updates; fall back to now the first
# time an un-stamped machine is updated.
_install_date() {
    if [[ -f /etc/hashiru-release ]]; then
        local existing
        existing="$(grep -m1 '^HASHIRU_INSTALL_DATE=' /etc/hashiru-release 2>/dev/null || true)"
        if [[ -n "${existing}" ]]; then
            echo "${existing#HASHIRU_INSTALL_DATE=}"
            return
        fi
    fi
    date -Is
}

# The install log is the whole record of a run, and quiet mode (the default on
# the ISO's first boot) puts *all* child output there rather than on screen —
# which makes reaching it a first-class command rather than a path to remember.
cmd_log() {
    if [[ ! -f "${HASHIRU_LOG}" ]]; then
        log_error "No install log at ${HASHIRU_LOG}"
        exit 1
    fi

    if [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]]; then
        exec tail -f "${HASHIRU_LOG}"
    fi

    # Open at the end — the interesting part of an install log is always the
    # bottom. Fall back to cat where there is no pager or no terminal.
    if [[ -t 1 ]] && command -v less &>/dev/null; then
        exec less +G "${HASHIRU_LOG}"
    fi
    exec cat "${HASHIRU_LOG}"
}

# The warnings digest, which install.sh prints at the end of a run and
# /etc/profile.d/hashiru-report.sh shows once on the first interactive login —
# and then renames to .last.txt. Both are checked here, because after that
# login the live path is gone and the digest was otherwise unreachable.
cmd_report() {
    local live="${HASHIRU_REPORT}"
    local archived="${HASHIRU_REPORT%.txt}.last.txt"

    if [[ -s "${live}" ]]; then
        echo "Warnings from the last install (${live}):"
        echo
        cat "${live}"
        echo
        echo "Full log: ${HASHIRU_LOG}  (hashiru log)"
    elif [[ -s "${archived}" ]]; then
        echo "Warnings from the last install (already shown at login):"
        echo
        cat "${archived}"
        echo
        echo "Full log: ${HASHIRU_LOG}  (hashiru log)"
    else
        echo "No warnings recorded — the last install finished clean."
    fi
}

# Release notes for the machine you are standing on. docs/releases/ is already
# the source CI reads for GitHub release bodies, so there is nothing new to keep
# in sync — this just makes it reachable without a browser.
cmd_changelog() {
    local dir="${HASHIRU_ROOT}/docs/releases"
    if [[ ! -d "${dir}" ]]; then
        log_error "No release notes at ${dir}"
        exit 1
    fi

    local files=()
    if [[ -n "${1:-}" ]]; then
        local one="${dir}/${1}.md"
        # Accept 'v1.7.1' and '1.7.1' alike.
        [[ -f "${one}" ]] || one="${dir}/v${1#v}.md"
        if [[ ! -f "${one}" ]]; then
            log_error "No release notes for '${1}' — try 'hashiru changelog' for the full list."
            exit 1
        fi
        files=("${one}")
    else
        # Newest first, by version rather than by name: -V sorts v1.10 after
        # v1.9, which a plain reverse sort gets wrong.
        mapfile -t files < <(find "${dir}" -maxdepth 1 -name 'v*.md' -type f | sort -Vr)
        if [[ ${#files[@]} -eq 0 ]]; then
            log_error "No release notes found in ${dir}"
            exit 1
        fi
    fi

    # Pick the pager before the pipe, not inside it: past a `|` stdout is the
    # pipe, so a `-t 1` test in there would always say "not a terminal".
    local pager=cat
    if [[ -t 1 ]] && command -v less &>/dev/null; then
        pager=less
    fi

    {
        local f
        for f in "${files[@]}"; do
            echo "===== ${f##*/} ====="
            echo
            cat "${f}"
            echo
        done
    } | "${pager}"
}

cmd_status() {
    if [[ -f /etc/hashiru-release ]]; then
        # shellcheck source=/dev/null
        source /etc/hashiru-release
        echo "version:   ${HASHIRU_VERSION:-unknown}"
        echo "commit:    ${HASHIRU_COMMIT:0:12}"
        echo "installed: ${HASHIRU_INSTALL_DATE:-unknown}"
        [[ -n "${HASHIRU_UPDATED:-}" ]] && echo "updated:   ${HASHIRU_UPDATED}"
    else
        echo "commit:    unknown (/etc/hashiru-release missing)"
    fi
    echo "repo:      ${HASHIRU_ROOT}"

    local behind
    behind="$(_behind_count)"
    if [[ -z "${behind}" ]]; then
        echo "upstream:  unknown (no upstream branch, or no network)"
    elif [[ "${behind}" -eq 0 ]]; then
        echo "upstream:  up to date"
    else
        echo "upstream:  ${behind} commit(s) behind — run 'hashiru update'"
    fi
}

case "${1:-help}" in
    update) shift; cmd_update "$@" ;;
    install) shift; exec "${HASHIRU_ROOT}/install.sh" "$@" ;;
    doctor) shift; exec "${HASHIRU_ROOT}/doctor.sh" "$@" ;;
    status) cmd_status ;;
    log) shift; cmd_log "$@" ;;
    report) cmd_report ;;
    changelog) shift; cmd_changelog "${1:-}" ;;
    help|-h|--help) usage ;;
    *) log_error "Unknown command: $1"; echo; usage; exit 1 ;;
esac
