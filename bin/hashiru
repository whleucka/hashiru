#!/usr/bin/env bash
# hashiru — manage an installed Hashiru system.
#
#   hashiru update [stage ...]   pull latest, then replay the install stages
#   hashiru update --no-confirm  ... without stopping to ask anything
#   hashiru doctor               read-only health check
#   hashiru config               edit this machine's overrides
#   hashiru version              what this machine is running
#   hashiru status               where this install came from, and how stale
#   hashiru log                  the install log
#   hashiru report               warnings from the last install
#   hashiru changelog            release notes, newest first
#
# `update` works by replaying install.sh, not by computing a diff: every stage
# is idempotent, and `stow --restow` in 45-config.sh reconciles added, removed
# and renamed config files on its own. Replay is the update mechanism.

set -euo pipefail

# Resolve the symlink first: this is normally invoked as /usr/local/bin/hashiru,
# where a plain dirname would put the repo at /usr/local and fail to find lib/.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SELF}")/.." && pwd)"

# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

usage() {
    cat << EOF
Usage: hashiru <command> [args]

Commands:
  update [stage ...]   Pull the latest Hashiru, then run install.sh.
                       Stage selectors are passed straight through, so
                       'hashiru update 45' re-applies only config and
                       'hashiru update 45+' runs stage 45 onward.
  install [stage ...]  Run install.sh WITHOUT pulling. For iterating on local
                       changes — 'update' refuses on a dirty checkout.
  doctor               Read-only health check (never modifies the system).
  config               Edit this machine's hashiru.conf in \$EDITOR, seeding it
                       from hashiru.conf.example the first time. Aliased as
                       'edit'. Machine-local *config* — monitors, kitty, waybar
                       — lives beside it in ~/.config/hashiru/.
  status               Show install provenance, checkout state, and whether a
                       pull is available.
  version              One line: the version this machine is running.
  log [-f|--last]      Page the install log; -f follows it live, --last shows
                       only the most recent run.
  report               Warnings from the last install, if there were any.
  changelog [tag]      Release notes, newest first, or just one tag's.
  help                 This message.

Stage selectors match install.sh: N, N+, --from N, or several at once.
'hashiru install --list' names every stage; anything else install.sh accepts
works through 'install' too, since that is a straight passthrough.

Flags (accepted by both 'update' and 'install', passed to install.sh):
  --no-confirm         Answer every prompt with yes. The only prompt a run has
                       left is the reboot at the end, so on a full run this
                       does reboot — pair it with --no-reboot if you'd rather
                       it didn't. Package transactions were already
                       non-interactive (pacman and yay run --noconfirm).
  --no-reboot          Never reboot and never ask. Wins over --no-confirm.
  --no-reflector       Skip stage 10's mirror ranking, worth about a minute.
                       reflector.timer has been re-ranking weekly since this
                       machine was built, so on an update the ranking buys
                       nothing; the timer stays enabled either way.

All three are per-machine settings too — HASHIRU_ASSUME_YES, HASHIRU_NO_REBOOT
and HASHIRU_NO_REFLECTOR in hashiru.conf ('hashiru config'). A flag raises its
knob for one run; leaving the flag off does not lower a configured one. To drop
one for a single run, set it in the environment: HASHIRU_NO_REBOOT=0 hashiru
update.

No flag touches the dirty-checkout refusal or the sudo password prompt:
the first is a hard error rather than a question, and the second can't be
answered with a "y". For a genuinely unattended update, warm the sudo
timestamp first ('sudo -v') or give the user NOPASSWD.

Repo: ${HASHIRU_ROOT}
EOF
}

# Fetch and report how far behind origin this checkout is. Echoes the number of
# commits behind; empty if that can't be determined (no remote, no network).
#
# Bounded, because this is `hashiru status` — the fast "where am I" command. A
# bare `git fetch` on a captive portal or a half-up network sits on TCP timeouts
# for minutes, and the honest answer after ten seconds is "unknown", which is
# already a state this prints. Only the upstream's own remote is fetched, so a
# checkout with a second remote configured doesn't pay for it here.
_behind_count() {
    local branch upstream remote
    branch="$(git -C "${HASHIRU_ROOT}" rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 0
    upstream="$(git -C "${HASHIRU_ROOT}" rev-parse --abbrev-ref "${branch}@{upstream}" 2>/dev/null)" || return 0
    remote="$(git -C "${HASHIRU_ROOT}" config --get "branch.${branch}.remote" 2>/dev/null)" || remote=""
    [[ -n "${remote}" ]] || remote="${upstream%%/*}"
    timeout 10 git -C "${HASHIRU_ROOT}" fetch --quiet "${remote}" 2>/dev/null || return 0
    git -C "${HASHIRU_ROOT}" rev-list --count "HEAD..${upstream}" 2>/dev/null || return 0
}

# Tracked changes only — the condition that actually blocks a fast-forward.
_tracked_dirty() {
    [[ -n "$(git -C "${HASHIRU_ROOT}" status --porcelain --untracked-files=no)" ]]
}

_untracked_count() {
    git -C "${HASHIRU_ROOT}" ls-files --others --exclude-standard 2>/dev/null | wc -l
}

cmd_update() {
    if [[ ! -d "${HASHIRU_ROOT}/.git" ]]; then
        log_error "${HASHIRU_ROOT} is not a git checkout — cannot update."
        log_error "Re-clone it: git clone https://github.com/whleucka/hashiru.git"
        exit 1
    fi

    # A dirty tree means local edits that a pull would either clobber or
    # conflict with. Local changes to a system's own config are legitimate —
    # they just need to be committed or stashed deliberately, not by this tool.
    #
    # Tracked files only. `git pull --ff-only` does not care about untracked
    # ones, so refusing over them blocked every update on a stray scratch file
    # in the checkout — and made a .gitignore entry the price of every runtime
    # file any stowed program happens to write. They are worth a line, not a
    # refusal.
    if _tracked_dirty; then
        log_error "${HASHIRU_ROOT} has uncommitted changes — commit or stash them first."
        git -C "${HASHIRU_ROOT}" status --short --untracked-files=no
        exit 1
    fi

    local untracked
    untracked="$(_untracked_count)"
    if (( untracked > 0 )); then
        log_info "${untracked} untracked file(s) in the checkout — left alone by this update"
    fi

    local before after
    before="$(git -C "${HASHIRU_ROOT}" rev-parse HEAD)"

    log_info "Pulling latest Hashiru into ${HASHIRU_ROOT}"
    if ! git -C "${HASHIRU_ROOT}" pull --ff-only; then
        log_error "Pull failed — resolve it manually, then re-run 'hashiru update'."
        exit 1
    fi

    after="$(git -C "${HASHIRU_ROOT}" rev-parse HEAD)"
    if [[ "${before}" == "${after}" ]]; then
        log_info "Already up to date (${after:0:12}) — replaying stages anyway to repair any drift"
    else
        log_info "Updated ${before:0:12} -> ${after:0:12}"
        git -C "${HASHIRU_ROOT}" --no-pager log --oneline "${before}..${after}" | head -20
    fi

    # install.sh stamps /etc/hashiru-release, and does it before the reboot
    # prompt. Stamping from out here instead used to race a `sudo reboot` that
    # install.sh had already enqueued; this just tells it that the run it is
    # about to do is an update, and that a stage-selected one still counts.
    export HASHIRU_STAMP_UPDATED=1
    "${HASHIRU_ROOT}/install.sh" "$@"

    # Read the version back out of the stamp install.sh just wrote, rather than
    # describing HEAD again: the stamp is what `hashiru status` will report, so
    # this line and that one cannot disagree.
    local version="unknown"
    if [[ -f /etc/hashiru-release ]]; then
        version="$(grep -m1 '^HASHIRU_VERSION=' /etc/hashiru-release 2>/dev/null || true)"
        version="${version#HASHIRU_VERSION=}"
        [[ -n "${version}" ]] || version="unknown"
    fi
    log_success "Update complete (${version})"
}

# The install log is the whole record of a run, and quiet mode (the default on
# the ISO's first boot) puts *all* child output there rather than on screen —
# which makes reaching it a first-class command rather than a path to remember.
cmd_log() {
    if [[ ! -f "${HASHIRU_LOG}" ]]; then
        log_error "No install log at ${HASHIRU_LOG}"
        exit 1
    fi

    case "${1:-}" in
        -f|--follow)
            exec tail -f "${HASHIRU_LOG}"
            ;;
        --last)
            # Just the most recent run. The log is appended to across every
            # install and update, and quiet mode puts whole pacman transactions
            # in it, so "what happened last time" is otherwise a scroll through
            # history. Logs written before the marker existed have none, and
            # awk's buffer is then the whole file — the old behaviour.
            local pager=(cat)
            if [[ -t 1 ]] && command -v less &>/dev/null; then
                pager=(less +G)
            fi
            awk '/^\[.*\] \[INFO\] ===== HASHIRU RUN START =====$/ { buf = "" }
                 { buf = buf $0 ORS }
                 END { printf "%s", buf }' "${HASHIRU_LOG}" | "${pager[@]}"
            return
            ;;
    esac

    # Open at the end — the interesting part of an install log is always the
    # bottom. Fall back to cat where there is no pager or no terminal.
    if [[ -t 1 ]] && command -v less &>/dev/null; then
        exec less +G "${HASHIRU_LOG}"
    fi
    exec cat "${HASHIRU_LOG}"
}

# The warnings digest, which install.sh prints at the end of a run and
# /etc/profile.d/hashiru-report.sh shows once on the first interactive login —
# and then renames to .last.txt. Both are checked here, because after that
# login the live path is gone and the digest was otherwise unreachable.
cmd_report() {
    local live="${HASHIRU_REPORT}"
    local archived="${HASHIRU_REPORT%.txt}.last.txt"

    if [[ -s "${live}" ]]; then
        echo "Warnings from the last install (${live}):"
        echo
        cat "${live}"
        echo
        echo "Full log: ${HASHIRU_LOG}  (hashiru log)"
    elif [[ -s "${archived}" ]]; then
        echo "Warnings from the last install (already shown at login):"
        echo
        cat "${archived}"
        echo
        echo "Full log: ${HASHIRU_LOG}  (hashiru log)"
    else
        echo "No warnings recorded — the last install finished clean."
    fi
}

# Release notes for the machine you are standing on. docs/releases/ is already
# the source CI reads for GitHub release bodies, so there is nothing new to keep
# in sync — this just makes it reachable without a browser.
cmd_changelog() {
    local dir="${HASHIRU_ROOT}/docs/releases"
    if [[ ! -d "${dir}" ]]; then
        log_error "No release notes at ${dir}"
        exit 1
    fi

    local files=()
    if [[ -n "${1:-}" ]]; then
        local one="${dir}/${1}.md"
        # Accept 'v1.7.1' and '1.7.1' alike.
        [[ -f "${one}" ]] || one="${dir}/v${1#v}.md"
        if [[ ! -f "${one}" ]]; then
            log_error "No release notes for '${1}' — try 'hashiru changelog' for the full list."
            exit 1
        fi
        files=("${one}")
    else
        # Newest first, by version rather than by name: -V sorts v1.10 after
        # v1.9, which a plain reverse sort gets wrong.
        mapfile -t files < <(find "${dir}" -maxdepth 1 -name 'v*.md' -type f | sort -Vr)
        if [[ ${#files[@]} -eq 0 ]]; then
            log_error "No release notes found in ${dir}"
            exit 1
        fi
    fi

    # Pick the pager before the pipe, not inside it: past a `|` stdout is the
    # pipe, so a `-t 1` test in there would always say "not a terminal".
    local pager=(cat)
    if [[ -t 1 ]] && command -v less &>/dev/null; then
        pager=(less)
    fi

    {
        local f
        for f in "${files[@]}"; do
            echo "===== ${f##*/} ====="
            echo
            cat "${f}"
            echo
        done
    } | "${pager[@]}"
}

# One line, for the people who type `--version` before they type `status`.
#
# The stamp is the answer, not `git describe`: the checkout is what the machine
# *would* be after a replay, and those differ precisely when someone pulled
# without running the stages. That gap is worth naming rather than papering
# over, so the two are compared and the difference is reported.
cmd_version() {
    local stamped="" checkout
    if [[ -f /etc/hashiru-release ]]; then
        stamped="$(grep -m1 '^HASHIRU_VERSION=' /etc/hashiru-release 2>/dev/null || true)"
        stamped="${stamped#HASHIRU_VERSION=}"
    fi
    checkout="$(git -C "${HASHIRU_ROOT}" describe --tags 2>/dev/null || echo unknown)"

    if [[ -z "${stamped}" || "${stamped}" == "unknown" ]]; then
        echo "hashiru ${checkout} (checkout — /etc/hashiru-release not stamped)"
    elif [[ "${stamped}" == "${checkout}" ]]; then
        echo "hashiru ${stamped}"
    else
        echo "hashiru ${stamped} (checkout is at ${checkout} — run 'hashiru update')"
    fi
}

# Open this machine's hashiru.conf. The override tree is the seam that lets a
# machine differ from the repo without forking it, and until now the only way to
# reach it was to remember the path and that an example file existed.
cmd_config() {
    local canonical="${HASHIRU_CONFIG_DIR}/hashiru.conf"
    local legacy="${HASHIRU_ROOT}/hashiru.conf"
    local example="${HASHIRU_ROOT}/hashiru.conf.example"
    local target="${canonical}"

    # A machine predating the move keeps its in-repo file, and common.sh still
    # reads it — so edit the one actually in use rather than creating a second.
    # Seeding the canonical path here would be worse than useless: the example
    # is entirely commented out, so the new file would win the lookup and set
    # nothing, leaving the real settings live but no longer where you edited.
    if [[ ! -f "${canonical}" && -f "${legacy}" ]]; then
        target="${legacy}"
        log_info "Editing the in-repo hashiru.conf; ~/.config/hashiru/ is the current home for it"
    elif [[ ! -f "${target}" ]]; then
        if [[ ! -f "${example}" ]]; then
            log_error "No ${example} to seed from"
            exit 1
        fi
        ensure_dir "${HASHIRU_CONFIG_DIR}"
        cp "${example}" "${target}"
        log_info "Seeded ${target} from hashiru.conf.example"
    fi

    # $VISUAL first: .zshrc sets both, and VISUAL is the one that means "a real
    # editor on a real terminal", which is what this is.
    local editor="${VISUAL:-${EDITOR:-}}"
    if [[ -z "${editor}" ]]; then
        local candidate
        for candidate in nvim vim vi nano; do
            if command -v "${candidate}" &>/dev/null; then
                editor="${candidate}"
                break
            fi
        done
    fi
    if [[ -z "${editor}" ]]; then
        log_error "No editor found — set \$EDITOR, or edit ${target} directly."
        exit 1
    fi

    # Word-split on purpose: EDITOR is conventionally a command line, not a
    # path, and "code --wait" has to survive being one.
    local cmd=()
    read -r -a cmd <<< "${editor}"
    exec "${cmd[@]}" "${target}"
}

cmd_status() {
    if [[ -f /etc/hashiru-release ]]; then
        # shellcheck source=/dev/null
        source /etc/hashiru-release
        local commit="${HASHIRU_COMMIT:-unknown}"
        echo "version:   ${HASHIRU_VERSION:-unknown}"
        echo "commit:    ${commit:0:12}"
        echo "installed: ${HASHIRU_INSTALL_DATE:-unknown}"
        [[ -n "${HASHIRU_UPDATED:-}" ]] && echo "updated:   ${HASHIRU_UPDATED}"
    else
        echo "commit:    unknown (/etc/hashiru-release missing)"
    fi
    echo "repo:      ${HASHIRU_ROOT}"

    # The one condition that makes `update` refuse, reported by the command you
    # would run to find out where you stand.
    local untracked
    untracked="$(_untracked_count)"
    if _tracked_dirty; then
        echo "checkout:  dirty — 'hashiru update' will refuse until this is committed or stashed"
        git -C "${HASHIRU_ROOT}" status --short --untracked-files=no | sed 's/^/           /'
    elif (( untracked > 0 )); then
        echo "checkout:  clean (${untracked} untracked file(s), which update ignores)"
    else
        echo "checkout:  clean"
    fi

    local behind
    behind="$(_behind_count)"
    if [[ -z "${behind}" ]]; then
        echo "upstream:  unknown (no upstream branch, or no network)"
    elif [[ "${behind}" -eq 0 ]]; then
        echo "upstream:  up to date"
    else
        echo "upstream:  ${behind} commit(s) behind — run 'hashiru update'"
    fi
}

case "${1:-help}" in
    update) shift; cmd_update "$@" ;;
    install) shift; exec "${HASHIRU_ROOT}/install.sh" "$@" ;;
    doctor) shift; exec "${HASHIRU_ROOT}/doctor.sh" "$@" ;;
    status) cmd_status ;;
    config|edit) cmd_config ;;
    version|--version|-V) cmd_version ;;
    log) shift; cmd_log "$@" ;;
    report) cmd_report ;;
    changelog) shift; cmd_changelog "${1:-}" ;;
    help|-h|--help) usage ;;
    *) log_error "Unknown command: $1"; echo; usage; exit 1 ;;
esac
